---
// 알약 모양 링크 목록 한 줄. Posts 페이지의 "시리즈"·"태그" 줄에 씁니다.
// 링크라서 JS 없이 동작하고, 현재 위치는 민트 배경 + aria-current로 표시합니다.
interface Item {
  label: string;
  href: string;
  active: boolean;
}

interface Props {
  label: string; // 줄 이름 (예: '태그')
  items: Item[];
}

const { label, items } = Astro.props;
const labelId = `chips-${label}`;
---

<div class="row">
  <p class="row-label" id={labelId}>{label}</p>
  <ul class="chips" aria-labelledby={labelId}>
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['chip', { active: item.active }]}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .row-label {
    flex: none;
    width: 44px;
    padding-top: 9px; /* 칩(40px) 글자와 높이 맞춤 */
    font-size: 13px;
    color: var(--text-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chip {
    display: inline-flex; /* a는 기본 inline이라 높이가 안 먹으므로 */
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 14px;
    color: var(--text);
    text-decoration: none;
  }
  .chip:hover {
    border-color: var(--mint);
    color: var(--mint);
  }
  /* 현재 위치: 민트 배경 + --bg 글자. :hover도 직접 지정해야 글자가 사라지지 않는다. */
  .chip.active,
  .chip.active:hover {
    border-color: var(--mint);
    background: var(--mint);
    color: var(--bg);
    font-weight: 500;
  }
</style>
