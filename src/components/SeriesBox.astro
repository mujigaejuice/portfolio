---
// 글 상세에서 같은 시리즈의 글 목록을 보여 주는 상자.
//   ┌ 시리즈 · DeepMesh 개발기 (2/3)
//   │ 1. 첫 글
//   │ 2. 지금 글 (굵게, 링크 아님)
//   │ 3. 셋째 글
import type { Post, SeriesInfo } from '../utils/posts';
import { postUrl, seriesUrl } from '../utils/urls';

interface Props {
  series: SeriesInfo;
  currentId: string;
}

const { series, currentId } = Astro.props;
const position = series.posts.findIndex((post: Post) => post.id === currentId) + 1;
---

<aside class="series-box" aria-label={`시리즈: ${series.name}`}>
  <p class="heading">
    <span class="kind">시리즈</span>
    <a href={seriesUrl(series.slug)} class="name">{series.name}</a>
    <span class="position">({position}/{series.posts.length})</span>
  </p>
  <ol class="list">
    {
      series.posts.map((post) => (
        <li>
          {post.id === currentId ? (
            <span class="current" aria-current="page">
              {post.data.title}
            </span>
          ) : (
            <a href={postUrl(post.id)}>{post.data.title}</a>
          )}
        </li>
      ))
    }
  </ol>
</aside>

<style>
  .series-box {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--mint);
    border-radius: 10px;
    font-size: 15px;
  }
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }
  .kind,
  .position {
    font-size: 13px;
    color: var(--text-muted);
  }
  .name {
    font-weight: 700;
    text-decoration: none;
  }
  .list {
    margin: 0;
    padding-left: 1.4em;
    color: var(--text-muted); /* 번호 색 */
  }
  .list li + li {
    margin-top: 4px;
  }
  .list a {
    color: var(--text-sub);
    text-decoration: none;
  }
  .list a:hover {
    color: var(--mint);
  }
  .current {
    color: var(--text);
    font-weight: 500;
  }
</style>
