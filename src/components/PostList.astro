---
// src/components/PostList.astro
import type { CollectionEntry } from 'astro:content';
import PostRow from './PostRow.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  emptyText?: string;
}

const { posts, emptyText = '아직 글이 없습니다.' } = Astro.props;
---

{
  posts.length > 0 ? (
    <ul class="post-list">
      {posts.map((post) => (
        <PostRow post={post} />
      ))}
    </ul>
  ) : (
    <p class="empty">{emptyText}</p>
  )
}

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .empty {
    color: var(--text-muted);
  }
</style>
