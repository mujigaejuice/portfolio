---
// 프로젝트 상세 (/projects/<id>/): 상태·기간, 설명, 스택·링크, 소개 본문(프로젝트 파일의 Markdown), 관련 글
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import ProjectPeriod from '../../components/ProjectPeriod.astro';
import { getPublishedPosts, getPostsByProject } from '../../utils/posts';
import { publicFileExists } from '../../utils/files';
import { PROJECTS_URL } from '../../utils/urls';
import '../../styles/prose.css';

export const getStaticPaths = (async () => {
  const [projects, posts] = await Promise.all([getCollection('projects'), getPublishedPosts()]);
  return Promise.all(
    projects.map(async (project) => ({
      params: { id: project.id },
      props: { project, related: await getPostsByProject(project.id, posts) },
    })),
  );
}) satisfies GetStaticPaths;

const { project, related } = Astro.props;
const { name, status, summary, stack, startDate, endDate, github, paper } = project.data;
const { Content } = await render(project);
// HTML 주석(작성 뼈대)만 있으면 아직 본문이 없는 것으로 본다 → '준비 중' 안내
const hasBody = (project.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim() !== '';
const showPaper = paper !== undefined && publicFileExists(paper);
const hasLinks = stack.length > 0 || github !== undefined || showPaper;
---

<BaseLayout title={name} description={summary}>
  <article class="project">
    <header class="project-header">
      <a href={PROJECTS_URL} class="back">← Projects</a>
      {
        (status || startDate) && (
          <p class="meta-line">
            {status && <span class="status">{status}</span>}
            <ProjectPeriod startDate={startDate} endDate={endDate} separator={status !== undefined} />
          </p>
        )
      }
      <h1 class="title">{name}</h1>
      <p class="summary">{summary}</p>
      {
        hasLinks && (
          <div class="links">
            {stack.length > 0 && <span class="stack">{stack.join(' · ')}</span>}
            {github && (
              <a href={github} rel="noopener">
                GitHub
              </a>
            )}
            {showPaper && (
              <a href={paper} class="paper">
                논문 PDF
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      hasBody ? (
        <div class="prose">
          <Content />
        </div>
      ) : (
        <p class="pending">프로젝트 소개 글을 준비하고 있습니다.</p>
      )
    }

    {
      related.length > 0 && (
        <section class="related" id="related" aria-labelledby="related-title">
          <h2 id="related-title">
            관련 글 <span class="count">{related.length}</span>
          </h2>
          <PostList posts={related} />
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .project {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .project-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--divider);
  }
  .back {
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--mint);
  }
  .meta-line {
    font-size: 13px;
  }
  .status {
    font-weight: 500;
    color: var(--pink); /* 상태 = 핑크 */
  }
  .title {
    font-size: 32px;
  }
  .summary {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-sub);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 14px;
  }
  .stack {
    color: var(--text-muted);
  }
  .paper {
    color: var(--pink); /* 핑크 = 읽어야 할 정보 */
  }
  .pending {
    padding: 20px;
    border: 1px dashed var(--border);
    border-radius: 12px;
    font-size: 15px;
    color: var(--text-muted);
  }
  .related {
    display: flex;
    flex-direction: column;
    gap: 4px;
    scroll-margin-top: 16px;
  }
  .count {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-muted);
  }
</style>
