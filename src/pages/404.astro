---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청한 페이지가 없습니다."
  noindex
>
  <section class="not-found">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="desc">주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">About으로 가기</a>
      <a class="btn btn-outline" href="/posts">글 목록 보기</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .code {
    font-size: 15px;
    color: var(--text-muted);
  }
  .desc {
    color: var(--text-sub);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
