---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../utils/posts';
import { EMAIL } from '../consts';

// featured 프로젝트를 order 순으로 최대 3개
const featured = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// 최근 글 3개 (draft 제외, 최신순)
const recentPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <h1>안녕하세요, 시하입니다.</h1>
    <p class="intro">
      Kubernetes 기반 마이크로서비스 환경의 침입 탐지를 연구합니다. [한 줄 소개]
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="/resume.pdf">이력서</a>
      <a class="btn btn-outline" href={`mailto:${EMAIL}`}>Email</a>
    </div>
  </section>

  <section class="section">
    <h2>프로젝트</h2>
    <div class="grid">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section">
    <h2>최근 글</h2>
    <PostList posts={recentPosts} />
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 8px;
  }
  .intro {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-sub);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); /* 넓으면 3열, 좁으면 1열 */
    gap: 16px;
  }
</style>
