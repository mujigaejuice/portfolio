---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, DEFAULT_OG_IMAGE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string; // '/og-default.png' 같은 사이트 내부 경로 또는 절대 URL
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date; // 글 상세에서만 넘김
  modifiedTime?: Date;
  noindex?: boolean; // 404처럼 검색 결과에 나오면 안 되는 페이지
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  imageAlt = `${SITE_TITLE} 대표 이미지`,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const ogTitle = title ?? SITE_TITLE;

// 절대 URL 만들기: astro.config.mjs의 site가 없으면 여기서 TypeError: Invalid URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const rssURL = new URL('/rss.xml', Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* 404 같은 noindex 페이지에 canonical을 넣으면 존재하지 않는 대표 주소를 선언하게 된다 */}
    {!noindex && <link rel="canonical" href={canonicalURL.href} />}
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }

    <!-- X(트위터): 나머지는 og:* 값을 사용 -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 피드, 사이트맵, 아이콘 -->
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <link
      rel="preload"
      href="/fonts/Pretendard-Regular.subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <Header />
    <main id="main" class="container site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
