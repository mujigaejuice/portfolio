---
// src/layouts/PostLayout.astro
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, slugify, toISODate } from '../utils/format';
import { POSTS_URL, postUrl, tagUrl } from '../utils/urls';
import SeriesBox from '../components/SeriesBox.astro';
import type { SeriesInfo } from '../utils/posts';
import '../styles/prose.css';

type Post = CollectionEntry<'posts'>;

interface Props {
  post: Post;
  prev?: Post; // 더 오래된 글
  next?: Post; // 더 최신 글
  series?: SeriesInfo; // 글이 속한 시리즈
}

const { post, prev, next, series } = Astro.props;
const { title, summary, date, updated, tags } = post.data;

// 기호로만 된 태그는 slug가 빈 문자열이 되어 태그 페이지가 없으므로 링크하지 않는다.
const tagLinks = tags
  .map((tag) => ({ tag, slug: slugify(tag) }))
  .filter(({ slug }) => slug !== '');
---

<BaseLayout
  title={title}
  description={summary}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
>
  <article class="post">
    <header class="post-header">
      <a href={POSTS_URL} class="back">← Posts</a>
      <h1 class="title">{title}</h1>
      <p class="meta">
        <time datetime={toISODate(date)}>{formatDate(date)}</time>
        {updated && <> (수정 {formatDate(updated)})</>}
        {tagLinks.map(({ tag, slug }) => (
          <>
            {' · '}
            <a href={tagUrl(slug)}>#{tag}</a>
          </>
        ))}
      </p>
    </header>

    {series && <SeriesBox series={series} currentId={post.id} />}

    <!-- 본문 스타일은 styles/prose.css (Markdown HTML에는 scoped 해시가 붙지 않으므로) -->
    <div class="prose">
      <slot />
    </div>

    {
      (prev || next) && (
        <nav class="pager" aria-label="이전 다음 글">
          {prev ? <a href={postUrl(prev.id)}>← {prev.data.title}</a> : <span />}
          {next ? <a href={postUrl(next.id)}>{next.data.title} →</a> : <span />}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .post {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .post-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--divider);
  }
  .back {
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--mint);
  }
  .title {
    font-size: 32px;
  }
  .meta {
    font-size: 14px;
    color: var(--text-muted);
  }
  .meta a {
    color: inherit;
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--mint);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--divider);
    font-size: 15px;
  }
  .pager a {
    padding: 10px 0;
    text-decoration: none;
  }
</style>
